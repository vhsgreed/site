---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { getAuthorName } from '../lib/authors';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---
<Base title="Blog: the build log" description="Build logs, guides, product writeups, and postmortems from vhsgreed: what we tried, what broke, what the numbers said, and what we changed because of it.">
  <div class="container">
    <section class="hero">
      <h1>Blog</h1>
      <p class="lead">
        The working record: build logs, guides, product writeups, and
        postmortems. We publish the process, not just the result.
      </p>
      <p class="muted">
        Looking for the full index of everything, including the data pages?
        That is <a href="/read/">Read</a>.
      </p>
    </section>

    <hr class="rule" />

    <section class="section-tight">
      <div class="card-list">
        {posts.map((p) => (
          <a class="card-row" href={`/blog/${p.id}/`}>
            <div>
              <div class="t">{p.data.title}</div>
              <div class="d">{p.data.description}</div>
            </div>
            <span class="meta">
              {getAuthorName(p.data.author) ? `${getAuthorName(p.data.author)} · ` : ''}
              {p.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
            </span>
          </a>
        ))}
      </div>
    </section>
  </div>
</Base>