---
import Base from '../../layouts/Base.astro';
import pages from '../../data/actor-pages.json';

export function getStaticPaths() {
  return pages.pages.map((p) => ({
    params: { slug: p.slug },
    props: { page: p },
  }));
}

const { page } = Astro.props;
const siblings = pages.pages.filter((p) => p.slug !== page.slug).slice(0, 5);
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      name: page.actorTitle,
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Apify',
      description: page.description,
      url: page.storeUrl,
      offers: { '@type': 'Offer', price: '0.00125', priceCurrency: 'USD' },
      author: { '@type': 'Organization', name: 'vhsgreed', url: 'https://vhsgreed.win' },
    },
    {
      '@type': 'FAQPage',
      mainEntity: page.faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---
<Base title={page.title} description={page.description}>
  <div class="container">
    <nav class="crumbs"><a href="/data/">&larr; All data source comparisons</a></nav>

    <section class="hero">
      <h1>{page.title}</h1>
      <p class="lead">{page.description}</p>
      <p>
        <a class="btn" href={page.storeUrl} rel="noopener">Open on the Apify Store</a>
      </p>
    </section>

    <section>
      <h2>What the API returns</h2>
      <p>
        Each run writes one record per company to the default dataset. Field names below are
        the actual dataset schema of the <strong>{page.actorTitle}</strong> actor.
      </p>
      <table>
        <thead>
          <tr><th>Field</th><th>Contents</th></tr>
        </thead>
        <tbody>
          {page.returns.map((r) => (
            <tr><td><code>{r.field}</code></td><td>{r.desc}</td></tr>
          ))}
        </tbody>
      </table>
    </section>

    <section>
      <h2>Official source, no API key needed</h2>
      <p><strong>{page.source.name}.</strong> {page.source.angle}</p>
    </section>

    <section>
      <h2>Pricing</h2>
      <p>{page.pricing} Pay-per-event pricing: pay for results, not for a subscription.</p>
      <p>
        <a href={page.storeUrl} rel="noopener">{page.actorTitle} on the Apify Store</a>
      </p>
    </section>

    <section>
      <h2>FAQ</h2>
      {page.faqs.map((f) => (
        <div class="faq">
          <h3>{f.q}</h3>
          <p>{f.a}</p>
        </div>
      ))}
    </section>

    <section>
      <h2>Related</h2>
      <ul>
        {siblings.map((s) => (
          <li><a href={`/api/${s.slug}/`}>{s.keyword}</a></li>
        ))}
      </ul>
      <p><a href="/data/">All data source comparisons</a></p>
    </section>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</Base>

<style>
  table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
  th, td { border: 1px solid var(--line); padding: 0.5rem 0.7rem; text-align: left; vertical-align: top; }
  thead th { background: var(--surface); }
  .crumbs { font-size: 0.85rem; color: var(--muted, #555); margin-bottom: 1rem; }
  .faq h3 { margin-bottom: 0.25rem; }
</style>
