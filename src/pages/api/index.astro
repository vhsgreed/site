---
import Base from '../../layouts/Base.astro';
import pages from '../../data/actor-pages.json';

const title = 'vhsgreed data APIs: registry, energy, property, and verification actors';
const description = 'One page per published vhsgreed Apify actor: official data sources, real output fields, and pay-per-event pricing. Nordic company registries, LEI, EU tenders, electricity spot prices, US property records, email verification, VIN decoding, app store metadata, certificates, and weather.';
---
<Base title={title} description={description}>
  <div class="container">
    <section class="hero">
      <h1>vhsgreed data APIs</h1>
      <p class="lead">
        Every published vhsgreed actor wraps an official data source and returns
        structured JSON at pay-per-event pricing. Coverage spans Nordic company
        registries, UK, French, Polish, and Czech registers, global LEI data, EU
        public tenders, Nordic electricity spot prices, US county property
        records, email verification, VIN decoding, App Store metadata, certificate
        discovery, and Nordic weather. Each page below lists the real output
        fields, the official source, pricing, and answers to the most common
        questions.
      </p>
    </section>
    <section>
      <h2>All actor pages</h2>
      <ul>
        {pages.pages.map((p) => (
          <li><a href={`/api/${p.slug}/`}>{p.keyword}</a></li>
        ))}
      </ul>
    </section>
    <section>
      <h2>Registry pages</h2>
      <p>
        The company registry family (Sweden via Allabolag and the official
        Bolagsverket register, Norway via both BRREG and proff.no,
        Denmark, Finland, UK, France, Poland, Lithuania, Switzerland, Czechia,
        and GLEIF LEI globally) reads
        official open-data registers directly:
        Enhetsregisteret in Norway, YTJ in Finland, SIRENE in France, KRS in
        Poland, Zefix in Switzerland. Where the source is open, the actor needs
        no API key, no account, and no proxy chain, which keeps runs cheap and
        results fresh from the register.
      </p>
      <p>
        Beyond registries, the fleet covers day-ahead electricity spot prices,
        EU TED procurement notices, county-level US property records, email
        verification, VIN and recall lookups, App Store metadata, crt.sh
        certificate discovery, and hourly Nordic weather forecasts.
      </p>
      <p>
        <a href="/data/">Data source comparisons</a> cover where each register
        sits against commercial aggregators.
      </p>
    </section>
  </div>
</Base>

<style>
  .crumbs { font-size: 0.85rem; color: var(--muted, #555); margin-bottom: 1rem; }
</style>
