---
import Base from '../layouts/Base.astro';
---
<Base title="About vhsgreed" description="Transparency statement, headquarters, funding model, contact, and privacy policy for vhsgreed, the self-funded AI R&D shop in Stockholm.">
  <div class="container">
    <section class="hero">
      <h1>About</h1>
    </section>

    <hr class="rule" />

    <section class="prose">

      <h2>Headquarters</h2>
      <p>
        Stockholm, Sweden.
      </p>

      <h2>Funding model:</h2>
      <p>
        Revenue comes from what we sell. That revenue funds the research and
        development. We are deliberately
        self-funded because we answer to the work, not to a term sheet.
      </p>

      <h2>Contact</h2>
      <p>
        <a href="mailto:lillerik.sund@gmail.com">lillerik.sund@gmail.com</a>
        <br />
        <span class="muted">We reply to everything relevant.</span>
      </p>
    </section>
  </div>
</Base>