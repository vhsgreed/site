---
import Base from '../../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('articles');
  const authors = await getCollection('authors');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, authors },
  }));
}

const { post, authors } = Astro.props;
const { Content } = await render(post);
const date = post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const author = post.data.author ? authors.find((a) => a.id === post.data.author) : undefined;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  author: author ? { '@type': 'Person', name: author.data.name } : { '@type': 'Organization', name: 'vhsgreed' },
  publisher: { '@type': 'Organization', name: 'vhsgreed', url: Astro.site?.toString() ?? 'https://vhsgreed.win' },
  mainEntityOfPage: { '@type': 'WebPage', '@id': Astro.url.href },
};
---
<Base title={post.data.title} description={post.data.description}>
  <article class="container" style="max-width: 760px; padding-top: 3rem;">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <p class="muted mono">
      {date}
      {author && (
        <>
          {' · '}
          <a href={`/authors/${author.id}/`}>By {author.data.name}</a>
        </>
      )}
    </p>
    <h1>{post.data.title}</h1>
    <p class="lead">{post.data.description}</p>
    {post.data.tags && (
      <p class="muted">
        {post.data.tags.map((t) => `#${t}`).join('  ')}
      </p>
    )}
    <hr class="rule" />
    <div class="prose">
      <Content />
    </div>
    {post.data.mediumUrl && (
      <p>
        <a class="btn btn-ghost" href={post.data.mediumUrl} target="_blank" rel="noopener">
          Read on Medium →
        </a>
      </p>
    )}
    <nav aria-label="Breadcrumb" style="margin-top: 2rem; font-size: 0.85rem;">
      <a href="/">Home</a>
      <span class="muted">&nbsp;›&nbsp;</span>
      <a href="/blog/">Blog</a>
      <span class="muted">&nbsp;›&nbsp;</span>
      <a href="/blog/articles/">Articles</a>
      <span class="muted">&nbsp;›&nbsp;</span>
      <span>{post.data.title}</span>
    </nav>
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site },
        { '@type': 'ListItem', position: 2, name: 'Blog', item: new URL('/blog/', Astro.site).href },
        { '@type': 'ListItem', position: 3, name: 'Articles', item: new URL('/blog/articles/', Astro.site).href },
        { '@type': 'ListItem', position: 4, name: post.data.title },
      ],
    })} />
  </article>
</Base>