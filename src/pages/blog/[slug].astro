---
// One page per post. The file name of the post is its address:
// src/content/posts/my-post.md  ->  /blog/my-post/
import Page from '../../layouts/Page.astro';
import ProductBox from '../../components/ProductBox.astro';
import PostList from '../../components/PostList.astro';
import { render } from 'astro:content';
import { site, topics } from '../../site';
import { getPosts, formatDate } from '../../posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, all: posts } }));
}
const { post, all } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const words = post.body?.split(/\s+/).length ?? 0;
const minutes = Math.max(1, Math.round(words / 230));
const related = all.filter((p) => p.data.topic === d.topic && p.id !== post.id).slice(0, 3);
---
<Page title={d.title} description={d.description} lang={d.lang} type="article">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: d.title,
    description: d.description,
    datePublished: d.date.toISOString(),
    inLanguage: d.lang,
    author: { '@type': 'Person', name: site.name, url: site.url + '/about/' },
  })} />
  <article class="post">
    <header>
      <p class="post-meta">
        <time datetime={d.date.toISOString()}>{formatDate(d.date)}</time>
        · <a href={`/topics/${d.topic}/`}>{topics[d.topic]}</a>
        · {minutes} min read
      </p>
      <h1>{d.title}</h1>
      <p class="lead">{d.description}</p>
    </header>
    <div class="prose">
      <Content />
    </div>
    {d.product && <ProductBox product={d.product} slug={post.id} />}
    {d.mediumUrl && <p class="muted">Also published on <a href={d.mediumUrl}>Medium</a>.</p>}
  </article>
  {related.length > 0 && (
    <section class="related" lang="en">
      <h2>More on {topics[d.topic].toLowerCase()}</h2>
      <PostList posts={related} showTopic={false} />
    </section>
  )}
</Page>
