---
import Base from '../layouts/Base.astro';

// Product catalog for the store page. url = Gumroad product link.
// Robotics goes live once Karl publishes the listing on Gumroad; until
// then the card shows "Ready to publish" instead of a buy link.
const products = [
  {
    name: 'Robotics Supply-Chain Intelligence 2026',
    price: '$15 suggested · $5 minimum',
    desc: '13,000+ assets, 1,093 verified companies across 11 countries, 60 exposure routes (direct / adjacent / indirect), prediction-market landscape, exposure guide.',
    url: 'https://store.vhsgreed.win/l/robotics-supply-chain-database-2026',
    status: 'live',
    tag: 'Data',
  },
  {
    name: 'Zero-Cost AI Agent Toolkit',
    price: 'Pay what you want · $1 suggested',
    desc: 'Free-model rotation, health probes, and posting helpers for budget-conscious autonomous agents. MIT.',
    url: 'https://vhsgreed.gumroad.com/l/rkszjw', 
    status: 'live',
    tag: 'Tooling',
  },
  {
    name: 'SEMICON Taiwan 2026 Exhibitor List',
    price: 'Pay what you want · $1 minimum',
    desc: 'The 2026 event exhibitor dataset. Time-bound research snapshot',
    url: 'https://vhsgreed.gumroad.com/l/yinutw',
    status: 'live',
    tag: 'Data',
  },
  {
    name: 'npm Supply-Chain Attack Timeline',
    price: 'Pay what you want · $1 minimum',
    desc: 'Complete timeline for 2026, 11 major incidents, packages, IOCs',
    url: 'https://vhsgreed.gumroad.com/l/mixqsd',
    status: 'live',
    tag: 'Data',
  },
  {
    name: 'Agent Alignment Charter Kit',
    price: '$5 suggested · $1 minimum',
    desc: 'The reproducible experiment kit behind the +0.83/5 self-modification shift: protocol, battery, rubric, scorer, 12 raw agent runs. MIT.',
    url: 'https://vhsgreed.gumroad.com/l/agent-alignment-charter-kit',
    status: 'live',
    tag: 'Research',
  },
];
---
<Base title="Store" description="Data products and tooling from vhsgreed, sold via Gumroad: robotics supply-chain data, AI agent tooling, research snapshots.">
  <div class="container">
    <section class="hero">
      <h1>Store</h1>
      <p class="lead">
        Everything is sold through Gumroad: instant download, pay what you
        want where it fits, no account required beyond checkout.
      </p>
    </section>

    <hr class="rule" />

    <section class="section-tight">
      <div class="card-list">
        {products.map((p) => (
          <div class="card-row card-row--stack">
            <div>
              <div class="t">{p.name}</div>
              <div class="d">{p.desc}</div>
              <span class="meta">{p.tag} · {p.price}</span>
            </div>
            {p.status === 'live' && p.url && (
              <div><a class="btn btn-accent" href={p.url} target="_blank" rel="noopener">Buy {p.name} on Gumroad →</a></div>
            )}
            {p.status === 'publish-pending' && (
              <div><a class="btn btn-ghost" href="/blog/robotics-supply-chain-2026/">Coming soon — read the writeup →</a></div>
            )}
            {p.status === 'archived' && (
              <div class="muted"><small>Archived. Contact us for the dataset.</small></div>
            )}
          </div>
        ))}
      </div>
    </section>

    <section class="prose section-tight" style="max-width: 72ch;">
      <h2>Why Gumroad</h2>
      <p>
        Instant delivery, our own pricing, and no monthly platform fee. If you
        need something custom, we also build to order: scraping and automation
        scripts, audits, and dataset work. <a href="/contact/">Contact us</a>.
      </p>
    </section>

    <hr class="rule" />

    <section class="section-tight" aria-label="The verification behind the products">
      <span class="kicker">The verification behind the products</span>
      <p class="muted" style="margin-top: 0.6rem;">
        Every product here ships with its method in the open. Read how the
        data was built and judged before you buy:
      </p>
      <div class="card-list" style="margin-top: 0.8rem;">
        <a class="card-row" href="/blog/robotics-supply-chain-2026/">
          <div><div class="t">Building the Verified Robotics Dataset</div>
          <div class="d">The harvest, the live verification, and the ticker bugs we caught.</div></div>
        </a>
        <a class="card-row" href="/robotics-stocks/">
          <div><div class="t">Robotics stocks by country</div>
          <div class="d">The public layer of the dataset: {`${377}+`} sample companies per nation, sources and dates on every row.</div></div>
        </a>
        <a class="card-row" href="/blog/crypto-portfolio-method/">
          <div><div class="t">The Ledger Method</div>
          <div class="d">How we track positions honestly. The same discipline the products are built on.</div></div>
        </a>
      </div>
    </section>
  </div>
</Base>