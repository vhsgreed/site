---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="That page does not exist on vhsgreed.">
  <div class="container" style="padding-top: 4rem; padding-bottom: 4rem;">
    <section class="hero">
      <h1>404</h1>
      <p class="lead">That page does not exist, or moved.</p>
      <div class="btn-row">
        <a class="btn btn-accent" href="/">Go home</a>
        <a class="btn btn-ghost" href="/blog/">Read the blog</a>
        <a class="btn btn-ghost" href="/store/">Browse the store</a>
      </div>
    </section>
  </div>
</Base>