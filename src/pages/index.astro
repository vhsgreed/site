---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const insights = (await getCollection('insights')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const posts = [
  ...articles.map((p) => ({ ...p, kind: 'articles' })),
  ...insights.map((p) => ({ ...p, kind: 'insights' })),
].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const latest = posts.slice(0, 3);

const siteUrl = Astro.site?.toString() ?? 'https://vhsgreed.win';
---
<Base title="Robotics supply-chain intelligence, AI tooling" description="Robotics supply-chain intelligence, open-source AI agent tooling, and honest research. Data-led, self-funded, built from Stockholm.">
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'vhsgreed',
    url: siteUrl,
    logo: `${siteUrl}/favicon.svg`,
    description: 'For-profit, self-funded AI R&D: robotics supply-chain intelligence, open-source agent tooling, honest data.',
    foundingDate: '2026',
    email: 'lillerik.sund@gmail.com',
    sameAs: [
      'https://github.com/vhsgreed',
      'https://vhsgreed.medium.com/',
      'https://vhsgreed.bsky.social/',
    ],
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'vhsgreed',
    url: siteUrl,
    potentialAction: {
      '@type': 'SearchAction',
      target: { '@type': 'EntryPoint', urlTemplate: `${siteUrl}/blog/?q={search_term_string}` },
      'query-input': 'required name=search_term_string',
    },
  })} />
  <div class="container">
    <section class="hero">
      <h1>
        Data-led research, <span class="glow">openly built</span>.
      </h1>
      <p class="lead">
        vhsgreed is a for-profit, self-funded R&amp;D shop: robotics supply-chain
        intelligence, open-source agent tooling, and audits that tell you what
        a dataset can and cannot do. Three doors: buy the data, read the
        research, learn the methods.
      </p>
      <div class="btn-row">
        <a class="btn btn-accent" href="/store/">Shop the store</a>
        <a class="btn btn-ghost" href="/robotics-stocks/">Explore research</a>
        <a class="btn btn-ghost" href="/learn/">Start learning</a>
      </div>
    </section>

    <hr class="rule" />

    <section class="section-tight" aria-label="The three pillars">
      <div class="grid">
        <div class="card">
          <span class="kicker">1 &middot; Store</span>
          <h2 class="card-h">Buy the data</h2>
          <p>Robotics supply-chain datasets: 13,000+ assets, 1,093 verified companies in 11 countries, exposure mapped across direct, adjacent, and indirect routes. Every product lists its sources and limits.</p>
          <p style="margin-top: 0.8rem;"><a class="btn btn-accent" href="/store/" data-track="home_store">Enter the store</a></p>
        </div>
        <div class="card">
          <span class="kicker">2 &middot; Research</span>
          <h2 class="card-h">Read the intelligence</h2>
          <p>The verified data behind the products: robotics stocks by country, humanoid and actuator supplier maps, precision reducers, the Unitree IPO case study. Nation by nation, ticker by ticker.</p>
          <p style="margin-top: 0.8rem;"><a class="btn btn-ghost" href="/robotics-stocks/">Explore research</a></p>
        </div>
        <div class="card">
          <span class="kicker">3 &middot; Learn</span>
          <h2 class="card-h">Learn the methods</h2>
          <p>Free explainers from the build log: agent alignment, orchestrator patterns, API cost control, supply-chain security, self-custody. The same methods we use to produce the data.</p>
          <p style="margin-top: 0.8rem;"><a class="btn btn-ghost" href="/learn/">Start learning</a></p>
        </div>
      </div>
    </section>

    <hr class="rule" />

    {latest.length > 0 && (
      <section class="blog-head" aria-label="Latest from the blog">
        <span class="kicker">Latest from the blog</span>
        <div class="card-list" style="margin-top: 0.8rem;">
          {latest.map((p) => (
            <a class="card-row" href={`/blog/${p.kind}/${p.id}/`}>
              <div>
                <div class="t">{p.data.title}</div>
                <div class="d">{p.data.description}</div>
              </div>
              <span class="meta">
                {p.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
              </span>
            </a>
          ))}
        </div>
        <p style="margin-top: 1rem;"><a href="/blog/">All blog posts →</a></p>
      </section>
    )}
  </div>
</Base>
