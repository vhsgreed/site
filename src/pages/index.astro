---
// Home = Writing: a short intro, then every post, newest first.
import Page from '../layouts/Page.astro';
import PostList from '../components/PostList.astro';
import TopicNav from '../components/TopicNav.astro';
import { site } from '../site';
import { getPosts } from '../posts';
const posts = await getPosts();
---
<Page>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: site.name,
    url: site.url,
    email: site.email,
    address: { '@type': 'PostalAddress', addressLocality: 'Stockholm', addressCountry: 'SE' },
  })} />
  <section class="intro">
    <h1>{site.tagline}</h1>
    <p>
      I'm Karl, a one-person business in Stockholm. I build web scrapers,
      automations and verified datasets, mostly with AI agents doing the
      heavy lifting. Below is everything I have written: build logs,
      research, and plain-English guides to running a small business in
      Sweden. <a href="/about/">More about me, or hire me</a>.
    </p>
  </section>
  <TopicNav />
  <PostList posts={posts} />
</Page>
