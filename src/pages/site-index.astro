---
import Base from '../layouts/Base.astro';
import { buildSiteTree, countEntries, type SiteSection } from '../lib/siteTree';

const sections: SiteSection[] = await buildSiteTree();
const total = countEntries(sections);
const title = 'Site Index';
const desc = `Generated automatically from the source on each build: ${total} pages.`;
---
<Base title={title} description={desc}>
  <div class="container">
    <section class="hero">
      <h1>Site-tree</h1>
      <p class="lead">
        Generated automatically
        from the source on each build: {total} pages. If a page
        exists, it is listed here.
      </p>
    </section>

    <hr class="rule" />

    <nav aria-label="Site index tree">
      {sections.map((s) => (
        <section class="section-tight">
          <h2>{s.href ? <a href={s.href}>{s.name}</a> : s.name}</h2>
          <ul>
            {s.entries.map((e) => (
              <li><a href={e.href}>{e.label}</a></li>
            ))}
          </ul>
        </section>
      ))}
    </nav>
  </div>
</Base>
