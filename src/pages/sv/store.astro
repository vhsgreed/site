---
import Base from '../../layouts/Base.astro';

const products = [
  {
    name: 'Robotics Supply-Chain Intelligence 2026',
    price: '$15 rekommenderat · $5 minimum',
    desc: '13 000+ tillgångar, 1 093 verifierade företag i 11 länder, 60 exponeringsrutter (direkta / angränsande / indirekta), prediction-market-landskap, exponeringsguide.',
    url: 'https://store.vhsgreed.win/l/robotics-supply-chain-database-2026',
    status: 'live',
    tag: 'Data',
  },
  {
    name: 'Zero-Cost AI Agent Toolkit',
    price: 'Betala vad du vill · $1 rekommenderat',
    desc: 'Fri modellrotation, hälso-prober och publiceringshjälpare för budgetmedvetna autonoma agenter. MIT.',
    url: 'https://vhsgreed.gumroad.com/l/rkszjw',
    status: 'live',
    tag: 'Verktyg',
  },
  {
    name: 'SEMICON Taiwan 2026 Exhibitor List',
    price: 'Betala vad du vill · $1 minimum',
    desc: 'Utställardataset från 2026 års evenemang. Tidsbunden forskningsögonblicksbild.',
    url: 'https://vhsgreed.gumroad.com/l/yinutw',
    status: 'live',
    tag: 'Data',
  },
  {
    name: 'npm Supply-Chain Attack Timeline',
    price: 'Betala vad du vill · $1 minimum',
    desc: 'Komplett tidslinje för 2026, 11 större incidenter, paket, IOCs.',
    url: 'https://vhsgreed.gumroad.com/l/mixqsd',
    status: 'live',
    tag: 'Data',
  },
  {
    name: 'Agent Alignment Charter Kit',
    price: '$5 rekommenderat · $1 minimum',
    desc: 'Det reproducerbara experimentkitet bakom +0.83/5 self-modification-skiftet: protokoll, batteri, bedömningsmatris, poängräknare, 12 råa agentkörningar. MIT.',
    url: 'https://vhsgreed.gumroad.com/l/agent-alignment-charter-kit',
    status: 'live',
    tag: 'Forskning',
  },
];
---
<Base title="Butik" description="Dataprodukter och verktyg från vhsgreed, sålda via Gumroad: robotics supply-chain-data, AI-agentverktyg, forskningsögonblicksbilder." locale="sv">
  <div class="container">
    <section class="hero">
      <h1>Butik</h1>
      <p class="lead">
        Allt säljs via Gumroad: direkt nedladdning, betala vad du vill där
        det passar, inget konto krävs utöver utcheckningen.
      </p>
    </section>

    <hr class="rule" />

    <section class="section-tight">
      <div class="card-list">
        {products.map((p) => (
          <div class="card-row card-row--stack">
            <div>
              <div class="t">{p.name}</div>
              <div class="d">{p.desc}</div>
              <span class="meta">{p.tag} · {p.price}</span>
            </div>
            {p.status === 'live' && p.url && (
              <div><a class="btn btn-accent" href={p.url} target="_blank" rel="noopener">Köp {p.name} på Gumroad →</a></div>
            )}
            {p.status === 'publish-pending' && (
              <div><a class="btn btn-ghost" href="/blog/robotics-supply-chain-2026/">Kommer snart: läs rapporten →</a></div>
            )}
            {p.status === 'archived' && (
              <div class="muted"><small>Arkiverad. Kontakta oss för datasetet.</small></div>
            )}
          </div>
        ))}
      </div>
    </section>

    <section class="prose section-tight" style="max-width: 72ch;">
      <h2>Varför Gumroad</h2>
      <p>
        Direkt leverans, vår egen prissättning och ingen månatlig
        plattformsavgift. Behöver du något skräddarsytt bygger vi också på
        beställning: scraping- och automatiseringsskript, granskningar och
        datasetarbete. <a href="/sv/contact/">Kontakta oss</a>.
      </p>
    </section>
  </div>
</Base>