---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const authors = (await getCollection('authors')).sort((a, b) =>
  a.data.name.localeCompare(b.data.name)
);


const guides = [
  { slug: 'agent-alignment', t: 'Agent-styrning', d: 'Avsikt mot instruktion, varför autonomi höjer insatsen, och hur styrning testas.' },
  { slug: 'agent-orchestrator', t: 'Agentorkestrerare', d: 'Planering, utspawning, modellroutning, tillstånd och verifieringsgrindar.' },
  { slug: 'semicon-taiwan-2026', t: 'SEMICON Taiwan 2026', d: 'Datum, plats, omfattning, teman och hur man använder utställarlistan.' },
  { slug: 'npm-supply-chain-attack', t: 'npm-försörjningskedjeattacken', d: 'Keyv/cacheable-masken: spridning, blinda fläckar, exponeringskontroll.' },
  { slug: 'reduce-api-costs', t: 'Sänk API-kostnader', d: 'Fri modellrotation, uppgiftsroutning, utvärdering, cachning, batchning.' },
  { slug: 'deepseek-vs-openrouter', t: 'DeepSeek mot OpenRouter', d: 'Direkt mot mellanled: prissättning, gratistier, rate limits.' },
  { slug: 'not-your-keys', t: 'Not your keys, not your crypto', d: 'Förvaring, motpartrisk och avvägningen slogans utelämnar.' },
  { slug: 'verify-scraping-provider', t: 'Verifiera en scraper-leverantör', d: 'En checklista från 150 live-prober.' },
  { slug: 'ai-benchmarking-2026', t: 'AI-benchmarking 2026', d: 'Varför en enda körning inte bevisar något.' },
];

const robotics = [
  { slug: 'index', t: 'Alla länder', d: 'Verifierade robotikbolag per land och index.' },
  { slug: 'actuator-stocks', t: 'Aktuatoraktier', d: 'Precisionsväxlar, vridmomentmotorer och rörelsemekanik.' },
  { slug: 'humanoid-robot-stocks', t: 'Humanoida robotaktier', d: 'OEM:er och leverantörer i humanoidbygget.' },
  { slug: 'precision-reducers', t: 'Precisionsväxlar', d: 'Flaskhalsen som upptar 40-55 procent av BOM.' },
  { slug: 'robotics-etf-vs-stocks', t: 'Robotik-ETF:er mot aktier', d: 'Samlad exponering mot enskilda bolag.' },
  { slug: 'unitree-ipo', t: 'Unitree-börsnoteringen', d: 'Öppningen på plus 629 procent och vad den prissatte.' },
];

const main = [
  { href: '/sv/', t: 'Hem', d: 'Startsidan: vad vhsgreed är och var du börjar.' },
  { href: '/sv/store/', t: 'Butik', d: 'Dataset och verktyg som säljs via Gumroad.' },
  { href: '/sv/learn/', t: 'Lär dig', d: 'Pedagogiska förklaringar av det vi arbetar med.' },
  { href: '/sv/robotics-stocks/', t: 'Robotaktier', d: 'Verifierade robotikexponerade bolag per land.' },
  { href: '/sv/opensource/', t: 'Open source', d: 'MIT-verktyg vi kör i produktion.' },
  { href: '/sv/mission/', t: 'Mission', d: 'Vilka vi är och missionsdeklarationen.' },
  { href: '/sv/about/', t: 'Om oss', d: 'Kontakt, finansiering, hur vi arbetar.' },
  { href: '/sv/authors/', t: 'Författare', d: 'Vem som skriver och publicerar här.' },
  { href: '/sv/contact/', t: 'Kontakt', d: 'Så når du oss.' },
  { href: '/sv/privacy/', t: 'Integritet', d: 'Integritetspolicy.' },
];

const kindLabel = (k: string) =>
  (({ 'build-log': 'Bygglogg', story: 'Berättelse', guide: 'Guide', insight: 'Insikt' } as Record<string, string>)[k] ?? 'Artikel');

const total = 1 + main.length + guides.length + robotics.length + posts.length + authors.length;
const title = 'Sajtindex';
const desc = `Varje indexerbar sida på vhsgreed.win, genererad vid bygget som ett kortträd: ${total} sidor över butiken, robotforskningen, learn-förklaringarna, bloggartiklarna och insikterna.`;
---
<Base title={title} description={desc} locale="sv">
  <div class="container">
    <section class="hero">
      <h1>Sajtindex</h1>
      <p class="lead">
        Varje indexerbar sida på den här sajten, genererad vid bygget. Grupperad
        som ett träd så att du ser hela strukturen på en gång. {total} sidor
        totalt.
      </p>
      <p class="muted">
        Sidan fungerar också som ett tillgänglighetsverktyg: en enda karta över
        alla ställen du kan landa på, i stället för att söka genom menyer.
      </p>
    </section>

    <hr class="rule" />

    <section class="section-tight">
      <div class="section-head"><span class="kicker">Forskning</span></div>
      <div class="card-list">
        {robotics.map((r) => (
          <a class="card-row" href={r.slug === 'index' ? '/sv/robotics-stocks/' : `/sv/robotics-stocks/${r.slug}/`}>
            <div>
              <div class="t">{r.t}</div>
              <div class="d">{r.d}</div>
            </div>
            <span class="meta">Robotics</span>
          </a>
        ))}
      </div>
    </section>

    <section class="section-tight">
      <div class="section-head"><span class="kicker">Lär dig</span></div>
      <div class="card-list">
        {guides.map((g) => (
          <a class="card-row" href={`/learn/${g.slug}/`}>
            <div>
              <div class="t">{g.t}</div>
              <div class="d">{g.d}</div>
            </div>
            <span class="meta">Guide</span>
          </a>
        ))}
      </div>
    </section>

    <section class="section-tight">
      <div class="section-head"><span class="kicker">Inlägg</span></div>
      <div class="card-list">
        {posts.map((p) => (
          <a class="card-row" href={`/blog/${p.id}/`}>
            <div>
              <div class="t">{p.data.title}</div>
              <div class="d">{p.data.description}</div>
            </div>
            <span class="meta">{p.data.date.toLocaleDateString('sv-SE', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
          </a>
        ))}
      </div>
    </section>

        <section class="section-tight">
      <div class="section-head"><span class="kicker">Författare</span></div>
      <div class="card-list">
        {authors.map((a) => (
          <a class="card-row" href={`/authors/${a.id}/`}>
            <div>
              <div class="t">{a.data.name}</div>
              <div class="d">{a.data.role}</div>
            </div>
            <span class="meta">Författare</span>
          </a>
        ))}
      </div>
    </section>

    <section class="section-tight">
      <div class="section-head"><span class="kicker">Sektioner</span></div>
      <div class="card-list">
        {main.map((m) => (
          <a class="card-row" href={m.href}>
            <div>
              <div class="t">{m.t}</div>
              <div class="d">{m.d}</div>
            </div>
          </a>
        ))}
      </div>
    </section>
  </div>
</Base>
