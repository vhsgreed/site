---
import Base from '../../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { getAuthorName } from '../../../lib/authors';

const posts = (await getCollection('insights')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const authorName = getAuthorName;
---
<Base title="Insikter" description="Produktsidor från vhsgreed: data, verktyg och resonemanget bakom." locale="sv">
  <div class="container">
    <section class="hero">
      <h1>Insikter</h1>
      <p class="lead">Produktsidor: data, verktyg och resonemanget.</p>
      <p class="muted">Inläggen är på engelska. <a href="/sv/blog/">← Tillbaka till bloggen</a></p>
    </section>

    <hr class="rule" />

    <section class="section-tight">
      <div class="card-list">
        {posts.map((p) => (
          <a class="card-row" href={`/blog/insights/${p.id}/`}>
            <div>
              <div class="t">
                {p.data.product?.name ? (
                  <span class="badge">{p.data.product.status === 'live' ? 'Köp' : 'Produkt'}</span>
                ) : null}
                {p.data.title}
              </div>
              <div class="d">{p.data.description}</div>
            </div>
            <span class="meta">
              {p.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
            </span>
          </a>
        ))}
      </div>
    </section>
  </div>
</Base>