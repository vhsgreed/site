---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const insights = (await getCollection('insights')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const posts = [
  ...articles.map((p) => ({ ...p, kind: 'articles' })),
  ...insights.map((p) => ({ ...p, kind: 'insights' })),
].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const latest = posts[0];
---
<Base title="" description="" locale="sv">
  <div class="container">
    <section class="hero">
      <h1>
        Datadriven forskning, <span class="glow">öppet byggd</span>.
      </h1>
      <p class="lead">
        vhsgreed är en vinstdrivande, självfinansierad FoU-verkstad: robotics
        supply-chain intelligence, agentverktyg med öppen källkod, och
        granskningar som berättar vad ett dataset kan och inte kan.
      </p>
      <p class="muted">
        Vi bygger dataprodukter och verktyg med en regel: inga påståenden vi
        inte kan styrka med en fil. Varje dataset listar sina källor och sina
        begränsningar. Intäkterna finansierar forskningen, så butiken och
        bloggen är samma verksamhet, inte två varumärken.
      </p>
      <div class="btn-row">
        <a class="btn btn-accent" href="/sv/store/">Till butiken</a>
        <a class="btn btn-ghost" href="/sv/mission/">Vår mission</a>
        <a class="btn btn-ghost" href="/sv/opensource/">Open source</a>
      </div>
    </section>

    <hr class="rule" />

    <section class="section-tight">
      <div class="grid">
        <a class="card" href="/sv/store/">
          <span class="kicker">Butik</span>
          <h2 class="card-h">Robotics supply-chain-data</h2>
          <p>13 000+ tillgångar, 1 093 verifierade företag i 11 länder, exponeringskarta över direkta, angränsande och indirekta rutter.</p>
          <span class="go">Bläddra bland dataset →</span>
        </a>
        <a class="card" href="/sv/opensource/">
          <span class="kicker">Open Source</span>
          <h2 class="card-h">Agentverktyg, MIT</h2>
          <p>Typosquat-skanning, probe-first scraping, attesterad benchmarking, fri modellrotation. Byggt offentligt.</p>
          <span class="go">Se repona →</span>
        </a>
        <a class="card" href="/sv/blog/">
          <span class="kicker">Blogg</span>
          <h2 class="card-h">Forskningsnoteringar</h2>
          <p>Vad vi lär oss medan vi bygger: sajtprober, AI-pipelines på fria modeller, supply-chain-postmortems, ärliga siffror.</p>
          <span class="go">Läs senaste →</span>
        </a>
        <a class="card" href="/sv/about/">
          <span class="kicker">Om oss</span>
          <h2 class="card-h">Självfinansierade, transparenta</h2>
          <p>Inget riskkapital, ingen reklam, ingen vidareförsäljning av data. Intäkterna finansierar forskningen. Full transparens.</p>
          <span class="go">Vilka vi är →</span>
        </a>
      </div>
    </section>

    {latest && (
      <section class="blog-head">
        <span class="kicker">Senaste från bloggen</span>
        <h2><a href={`/blog/${latest.kind}/${latest.id}/`} style="color: inherit; text-decoration: none;">{latest.data.title}</a></h2>
        <p class="muted">
          {latest.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
          &nbsp;·&nbsp; {latest.data.description}
        </p>
        <p><a href={`/sv/blog/${latest.kind}/${latest.id}/`}>Läs inlägget →</a></p>
      </section>
    )}
  </div>
</Base>