---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { siteTitle as siteName, siteDescription as siteDescDefault, gaId, navLanes, utilityLinks } from '../config/site.config.js';

// Tracking: Cloudflare Web Analytics (cookieless, privacy-preserving).
// No consent banner needed; zero personal data. Replace TOKEN with the
// site token from Cloudflare dashboard when the beacon is created.
const CF_ANALYTICS_TOKEN = '18487266547a420dbf8ba750d15c869c';

const { title, description } = Astro.props;

// Breadcrumbs: Home / Lane / page path segments. Lane labels come from
// site.config.js — adding a page never touches this.
const crumbs = (() => {
  const path = Astro.url.pathname.replace(/\/$/, '');
  if (path === '') return [];
  const parts = path.split('/').filter(Boolean);
  const all = [...navLanes, ...utilityLinks];
  const out = parts.map((seg, i) => {
    const prefix = '/' + parts.slice(0, i + 1).join('/') + '/';
    const lane = all.find((l) => l.href === prefix);
    if (lane) return { label: lane.label, href: i < parts.length - 1 ? prefix : null };
    const label = seg === 'index' ? '' : seg.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
    return { label, href: i < parts.length - 1 ? prefix : null };
  });
  return out;
})();

const siteTitle = title ? `${title}: ${siteName}` : `${siteName}: for-profit, self-funded AI R&D`;

const siteDesc = description ?? siteDescDefault;
const ogImage = Astro.url.origin + '/img/og-card.jpg';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name='impact-site-verification' value='ebdc22a7-9a80-43ae-a680-247959c1b70a' />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0c0c0c" media="(prefers-color-scheme: dark)" />
    <title>{siteTitle}</title>
    <meta name="description" content={siteDesc} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Font: Open Sans (locked). Google Fonts like the approved design prototype. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700&display=swap" />
    <link rel="canonical" href={Astro.url} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={siteDesc} />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:site_name" content="vhsgreed" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <!-- GA4 loads ONLY after cookie consent (see CookieConsent.astro, Consent Mode v2, default denied). -->
    <!-- First-party telemetry (cookieless beacons) + UI utilities (menu, scroll, spy) -->
    <script src="../scripts/telemetry.js"></script>
    <script src="../scripts/ui.js"></script>
    {CF_ANALYTICS_TOKEN !== 'YOUR_CF_WEB_ANALYTICS_TOKEN' && (
      <script
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token": "${CF_ANALYTICS_TOKEN}"}`}
      ></script>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
      <div id="progress" aria-hidden="true"></div>
      <button id="toTop" type="button" aria-label="Back to top">&uarr; Top</button>
      <Nav />
      {Astro.url.pathname !== '/' && (
        <nav class="breadcrumbs wrap" aria-label="Breadcrumb">
          <a href="/">Home</a>
          {crumbs.map((c) => (
            <>
              <span aria-hidden="true"> / </span>
              {c.href ? <a href={c.href}>{c.label}</a> : <span>{c.label}</span>}
            </>
          ))}
        </nav>
      )}
    <main id="main">
      <slot />
    </main>
    <Footer />
    <CookieConsent />
  </body>
</html>