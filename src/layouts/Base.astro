---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

// Tracking: Cloudflare Web Analytics (cookieless, privacy-preserving).
// No consent banner needed; zero personal data. Replace TOKEN with the
// site token from Cloudflare dashboard when the beacon is created.
const CF_ANALYTICS_TOKEN = 'YOUR_CF_WEB_ANALYTICS_TOKEN';

const { title, description, locale = 'en' } = Astro.props;

const lang = locale === 'sv' ? 'sv' : 'en';
const siteTitle = title
  ? `${title} — vhsgreed`
  : locale === 'sv'
    ? 'vhsgreed — vinstdrivande, självfinansierad AI-FoU'
    : 'vhsgreed — for-profit, self-funded AI R&D';

const defaultDesc =
  locale === 'sv'
    ? 'Robotics supply-chain intelligence, agentverktyg med öppen källkod och ärlig forskning. Vinstdrivande, självfinansierat, byggt från Stockholm.'
    : 'Robotics supply-chain intelligence, open-source agent tooling, and honest research. For-profit, self-funded, built from Stockholm.';

const siteDesc = description || defaultDesc;
const ogImage = Astro.url.origin + '/og-default.svg';

// hreflang alternates: strip /sv/ prefix for en, add it for sv
const isSv = locale === 'sv';
const pathname = Astro.url.pathname.replace(/\/$/, '') || '';
const enPath = isSv ? pathname.replace(/^\/sv/, '') || '/' : pathname || '/';
const svPath = isSv ? (pathname || '/') : (pathname === '/' ? '/sv/' : `/sv${pathname}`) + '/';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{siteTitle}</title>
    <meta name="description" content={siteDesc} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={Astro.url} />
    <link rel="alternate" hreflang="en" href={new URL(enPath, Astro.url.origin).href} />
    <link rel="alternate" hreflang="sv" href={new URL(svPath, Astro.url.origin).href} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={siteDesc} />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:site_name" content="vhsgreed" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    {CF_ANALYTICS_TOKEN !== 'YOUR_CF_WEB_ANALYTICS_TOKEN' && (
      <script
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token": "${CF_ANALYTICS_TOKEN}"}`}
      ></script>
    )}
  </head>
  <body>
    <Nav locale={locale} langSwitchUrl={locale === 'sv' ? enPath : svPath} langSwitchLabel={locale === 'sv' ? 'English' : 'Svenska'} />
    <main>
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>