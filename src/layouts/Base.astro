---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

// Tracking: Cloudflare Web Analytics (cookieless, privacy-preserving).
// No consent banner needed; zero personal data. Replace TOKEN with the
// site token from Cloudflare dashboard when the beacon is created.
const CF_ANALYTICS_TOKEN = 'YOUR_CF_WEB_ANALYTICS_TOKEN';

const { title, description } = Astro.props;

const siteTitle = title ? `${title}: vhsgreed` : 'vhsgreed: for-profit, self-funded AI R&D';

const siteDesc =
  description ??
  'Robotics supply-chain intelligence, open-source agent tooling, and honest research. For-profit, self-funded, built from Stockholm.';
const ogImage = Astro.url.origin + '/img/og-card.jpg';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      // Theme: stored choice wins; else system. Applied before first paint (no flash).
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t;
        } catch (e) {}
      })();
      // Shared toggle + label sync (labels read opposite of current mode)
      (function () {
        function effective() {
          var t = document.documentElement.dataset.theme;
          if (t === 'dark' || t === 'light') return t;
          return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        function sync() {
          var t = effective();
          document.querySelectorAll('[data-theme-label]').forEach(function (el) {
            el.textContent = t === 'dark' ? 'Light mode' : 'Dark mode';
          });
        }
        window.__theme = {
          toggle: function () {
            var t = effective() === 'dark' ? 'light' : 'dark';
            document.documentElement.dataset.theme = t;
            try { localStorage.setItem('theme', t); } catch (e) {}
            sync();
          },
          sync: sync
        };
        document.addEventListener('click', function (e) {
          if (e.target.closest('[data-theme-toggle]')) { e.preventDefault(); window.__theme.toggle(); }
        });
        document.addEventListener('DOMContentLoaded', sync);
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name='impact-site-verification' value='ebdc22a7-9a80-43ae-a680-247959c1b70a' />
    <title>{siteTitle}</title>
    <meta name="description" content={siteDesc} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={Astro.url} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={siteDesc} />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:site_name" content="vhsgreed" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <!-- Google tag (gtag.js), GA4 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-E2E4K53319"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-E2E4K53319');

      // Declarative conversion tracking: any element with [data-track] fires a GA4 event on click.
      document.addEventListener('click', function (e) {
        var el = e.target.closest('[data-track]');
        if (el && window.gtag) {
          var label = el.getAttribute('data-track');
          var href = el.getAttribute('href') || '';
          gtag('event', label, {
            event_category: 'outbound',
            event_label: label,
            link_url: href,
            transport_type: 'beacon'
          });
        }
      });
    </script>
    {CF_ANALYTICS_TOKEN !== 'YOUR_CF_WEB_ANALYTICS_TOKEN' && (
      <script
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token": "${CF_ANALYTICS_TOKEN}"}`}
      ></script>
    )}
  </head>
  <body>
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>