---
// Footer: demo design language — brand top rule, surface background.
// Lanes + utility from site.config.js; research index links stay curated.
import { navLanes, utilityLinks } from '../config/site.config.js';

const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <p class="foot-h">Sections</p>
        {navLanes.map((l) => <a href={l.href}>{l.label}</a>)}
      </div>
      <div>
        <p class="foot-h">Research index</p>
        <a href="/robotics-stocks/">Robotics stocks</a>
        <a href="/companies/">Swedish listed companies</a>
        <a href="/blog/npm-supply-chain-attack/">npm supply-chain attacks</a>
        <a href="/blog/agent-alignment/">Agent alignment</a>
      </div>
      <div>
        <p class="foot-h">Utility</p>
        {utilityLinks.map((l) => <a href={l.href}>{l.label}</a>)}
        <a href="#" data-cookie-settings>Cookie settings</a>
      </div>
    </div>
    <div class="legal">
      &copy; {year} vhsgreed &middot; Stockholm, Sweden.
    </div>
  </div>
</footer>
