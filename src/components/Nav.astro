---
// Three-pillar nav: Store, Research, Learn. Blog stays reachable as the
// fourth link. Utility pages (About, Mission, etc.) live in the footer.
const primary = [
  { href: '/store/', label: 'Store' },
  { href: '/robotics-stocks/', label: 'Research' },
  { href: '/learn/', label: 'Learn' },
  { href: '/blog/', label: 'Blog' },
];
// Mobile menu adds the utility pages so they stay reachable without JS.
const utility = [
  { href: '/opensource/', label: 'Open Source' },
  { href: '/mission/', label: 'Mission' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
  { href: '/authors/', label: 'Authors' },
];
const current = Astro.url.pathname;
const isCurrent = (href: string) => {
  const base = href.replace(/\/$/, '');
  return current === href || current === base || current.startsWith(base + '/');
};
---
<header class="nav">
  <div class="nav-inner">
    <a class="brand" href="/" aria-label="vhsgreed home">
      <svg viewBox="0 0 64 64" aria-hidden="true">
        <rect width="64" height="64" rx="12" fill="#0A0A0A" />
        <path d="M14 18 L32 50 L50 18" fill="none" stroke="#A3E635" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      vhsgreed
    </a>

    <nav class="nav-links" aria-label="Primary">
      {primary.map((l) => (
        <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>

    <!-- Mobile menu: plain HTML <details>, works without JavaScript -->
    <details class="nav-toggle">
      <summary aria-label="Open menu">Menu</summary>
      <nav class="nav-panel" aria-label="Mobile">
        {primary.map((l) => (
          <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a>
        ))}
        {utility.map((l) => (
          <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a>
        ))}
      </nav>
    </details>
  </div>
</header>
