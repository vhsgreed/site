---
// Topband nav: desktop inline lanes (≥1024px) + mobile overlay menu.
// Lanes + utility links come from site.config.js — adding a page never
// touches this file. Menu JS lives in src/scripts/ui.js (shared budget).
import { navLanes, utilityLinks } from '../config/site.config.js';

const current = Astro.url.pathname;
const isCurrent = (href: string) => {
  const base = href.replace(/\/$/, '');
  return current === href || current === base || current.startsWith(base + '/');
};
---
<header>
  <div class="topband">
    <div class="container">
      <a class="wordmark" href="/" aria-label="vhsgreed home">vhsgreed</a>
      <nav aria-label="Primary">
        {navLanes.map((l) => (
          <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a>
        ))}
      </nav>
      <button class="menu-btn" id="menuBtn" type="button" aria-expanded="false" aria-controls="mm">Menu</button>
    </div>
  </div>
  <div class="mobilemenu" id="mm">
    {navLanes.map((l) => (
      <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a>
    ))}
    <span class="mm-label" aria-hidden="true">More</span>
    {utilityLinks.map((l) => (
      <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a>
    ))}
  </div>
</header>
