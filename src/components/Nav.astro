---
// Two-path nav (agreed 09-01): Store + Read, plus Search. Utility pages in
// the footer and the mobile panel. Theme toggle is inline with the links;
// mobile uses a JS menu (curtain <details> retired 09-02).
const primary = [
  { href: '/store/', label: 'Store' },
  { href: '/read/', label: 'Read' },
  { href: '/search/', label: 'Search' },
];
const current = Astro.url.pathname;
const isCurrent = (href: string) => {
  const base = href.replace(/\/$/, '');
  return current === href || current === base || current.startsWith(base + '/');
};
---
<header class="nav">
  <div class="nav-inner">
    <a class="brand" href="/" aria-label="vhsgreed home">
      <svg viewBox="0 0 64 64" aria-hidden="true">
        <rect width="64" height="64" rx="12" fill="#0A0A0A" />
        <path d="M14 18 L32 50 L50 18" fill="none" stroke="#A3E635" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      vhsgreed
    </a>

    <nav class="nav-links" aria-label="Primary">
      {primary.map((l) => (
        <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a>
      ))}
      <button class="theme-toggle" type="button" data-theme-toggle>
        <span data-theme-label>Dark mode</span>
      </button>
    </nav>

    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-panel">
      Menu
    </button>

    <div id="mobile-panel" class="mobile-panel" aria-hidden="true">
      <div class="panel-head">
        <span>vhsgreed</span>
        <button class="panel-close" type="button" data-panel-close>Close ✕</button>
      </div>
      <nav aria-label="Mobile">
        {primary.map((l) => (
          <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a>
        ))}
        <button class="theme-toggle" type="button" data-theme-toggle>
          <span data-theme-label>Dark mode</span>
        </button>
      </nav>
    </div>
  </div>
</header>

<script>
  // Mobile panel: proper JS menu (open/close, Escape, outside click, close on navigate)
  var btn = document.querySelector('.menu-btn');
  var panel = document.getElementById('mobile-panel');
  function closePanel() {
    if (!panel || !panel.classList.contains('open')) return;
    panel.classList.remove('shown');
    panel.setAttribute('aria-hidden', 'true');
    btn.setAttribute('aria-expanded', 'false');
    setTimeout(function () { panel.classList.remove('open'); }, 300);
  }
  if (btn && panel) {
    btn.addEventListener('click', function () {
      if (panel.classList.contains('open')) { closePanel(); return; }
      panel.classList.add('open');
      panel.setAttribute('aria-hidden', 'false');
      btn.setAttribute('aria-expanded', 'true');
      // two-phase: render off-canvas, then transition in (reliable on iOS)
      requestAnimationFrame(function () {
        requestAnimationFrame(function () { panel.classList.add('shown'); });
      });
    });
    if (panel.querySelector('[data-panel-close]')) {
      panel.querySelector('[data-panel-close]').addEventListener('click', closePanel);
    }
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closePanel(); });
    document.addEventListener('click', function (e) {
      if (!panel.hidden && !panel.contains(e.target) && !btn.contains(e.target)) closePanel();
    });
    panel.addEventListener('click', function (e) { if (e.target.closest('a')) closePanel(); });
  }
</script>