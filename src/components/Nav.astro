---
const { locale = 'en', langSwitchUrl, langSwitchLabel } = Astro.props;
const sv = locale === 'sv';

const links = [
  { href: sv ? '/sv/' : '/', label: sv ? 'Hem' : 'Home' },
  { href: sv ? '/sv/robotics-stocks/' : '/robotics-stocks/', label: sv ? 'Robotaktier' : 'Robotics Stocks' },
  { href: sv ? '/sv/blog/' : '/blog', label: sv ? 'Blogg' : 'Blog' },
  { href: sv ? '/sv/store/' : '/store', label: sv ? 'Butik' : 'Store' },
];
const moreLinks = [
  { href: sv ? '/sv/mission/' : '/mission', label: sv ? 'Mission' : 'Mission' },
  { href: sv ? '/sv/opensource/' : '/opensource', label: sv ? 'Open Source' : 'Open Source' },
  { href: sv ? '/sv/about/' : '/about', label: sv ? 'Om oss' : 'About' },
  { href: sv ? '/sv/contact/' : '/contact', label: sv ? 'Kontakt' : 'Contact' },
  { href: sv ? '/sv/authors/' : '/authors', label: sv ? 'Författare' : 'Authors' },
];
const current = Astro.url.pathname;
---
<header class="nav">
  <div class="nav-inner">
    <a class="brand" href={sv ? '/sv/' : '/'} aria-label="vhsgreed home">
      <svg viewBox="0 0 64 64" aria-hidden="true">
        <rect width="64" height="64" rx="12" fill="#0A0A0A" />
        <path d="M14 18 L32 50 L50 18" fill="none" stroke="#A3E635" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      vhsgreed
    </a>

    <nav class="nav-links" aria-label="Primary">
      {links.map((l) => (
        <a href={l.href} aria-current={current === l.href || current === (l.href.replace(/\/$/, '') + '/') ? 'page' : undefined}>{l.label}</a>
      ))}
      <details class="nav-more">
        <summary>{sv ? 'Mer' : 'More'}</summary>
        <div class="nav-more-panel">
          {moreLinks.map((l) => (
            <a href={l.href} aria-current={current === l.href ? 'page' : undefined}>{l.label}</a>
          ))}
          <a href={langSwitchUrl} class="lang-switch">{langSwitchLabel}</a>
        </div>
      </details>
    </nav>

    <!-- Mobile menu: plain HTML <details>, works without JavaScript -->
    <details class="nav-toggle">
      <summary>Menu</summary>
      <nav class="nav-panel" aria-label="Mobile">
        {links.map((l) => (
          <a href={l.href}>{l.label}</a>
        ))}
        {moreLinks.map((l) => (
          <a href={l.href}>{l.label}</a>
        ))}
        <a href={langSwitchUrl} class="lang-switch">{langSwitchLabel}</a>
      </nav>
    </details>
  </div>
</header>