---
// HeroGradient.astro — our own MIT WebGL mesh-gradient (Stripe-style look,
// clean-room implementation). Renders a slowly-morphing lime/charcoal mist
// on a white (light) or near-black (dark) base. Respects
// prefers-color-scheme + prefers-reduced-motion; static CSS fallback.
---

<canvas id="hero-gradient" class="hero-gradient" aria-hidden="true"></canvas>

<script>
  const canvas = document.getElementById('hero-gradient');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const dark = window.matchMedia('(prefers-color-scheme: dark)').matches;

  // Brand palette (BRAND-COLORS.md): lime mist + charcoal on white/near-black.
  const COLORS = dark
    ? { base: [0.047, 0.047, 0.047], accents: [[0.302, 0.486, 0.059], [0.639, 0.902, 0.208], [0.18, 0.18, 0.18]] }   // #0C0C0C base, #4D7C0F, #A3E635, #2E2E2E
    : { base: [1.0, 1.0, 1.0],       accents: [[0.639, 0.902, 0.208], [0.10, 0.10, 0.10], [0.302, 0.486, 0.059]] };  // #FFFFFF base, #A3E635, #1A1A1A, #4D7C0F

  const gl = canvas.getContext('webgl', { antialias: false, alpha: false });
  if (gl && !reduced) {
    const vs = 'attribute vec2 p; void main(){ gl_Position = vec4(p, 0.0, 1.0); }';
    const fs = `
      precision lowp float;
      uniform vec2 u_res;
      uniform float u_time;
      uniform vec3 u_base;
      uniform vec3 u_c1;
      uniform vec3 u_c2;
      uniform vec3 u_c3;
      vec3 blend(vec3 base, vec3 c, float t, vec2 seed) {
        // value-noise fbm, 2 octaves, slow drift = the "ink in water" look
        vec2 uv = gl_FragCoord.xy / u_res.xy;
        float n = 0.0;
        vec2 p = uv * (1.6 + seed.x) + seed * 13.7;
        float a = 0.55;
        for (int i = 0; i < 2; i++) {
          n += a * sin(p.x + u_time * (0.08 + 0.05 * seed.y)) * sin(p.y - u_time * (0.06 + 0.04 * seed.x));
          p = p * 2.1 + vec2(3.1, 1.7);
          a *= 0.5;
        }
        n = n * 0.5 + 0.5;
        n = pow(clamp(n, 0.0, 1.0), 1.4);
        // edge-weighted: mists concentrate toward corners/edges, center stays clean
        float edge = 1.0 - smoothstep(0.15, 0.75, distance(uv, vec2(0.5)) * 1.6);
        float m = clamp(n * (0.45 + 0.55 * edge) * t, 0.0, 1.0);
        return mix(base, c, m);
      }
      void main() {
        vec3 c = u_base;
        c = blend(c, u_c1, 0.85, vec2(0.3, 0.7));
        c = blend(c, u_c2, 0.45, vec2(0.8, 0.2));
        c = blend(c, u_c3, 0.35, vec2(0.5, 0.9));
        // gentle vignette so text area stays clean
        vec2 uv = gl_FragCoord.xy / u_res.xy;
        c = mix(c, u_base, smoothstep(0.25, 0.05, distance(uv, vec2(0.5, 0.62))));
        gl_FragColor = vec4(c, 1.0);
      }`;

    function compile(type, src) {
      const s = gl.createShader(type);
      gl.shaderSource(s, src); gl.compileShader(s);
      return gl.getShaderParameter(s, gl.COMPILE_STATUS) ? s : null;
    }
    const vsOK = compile(gl.VERTEX_SHADER, vs), fsOK = compile(gl.FRAGMENT_SHADER, fs);
    if (vsOK && fsOK) {
      const prog = gl.createProgram();
      gl.attachShader(prog, vsOK); gl.attachShader(prog, fsOK); gl.linkProgram(prog);
      gl.useProgram(prog);
      const buf = gl.createBuffer();
      gl.bindBuffer(gl.ARRAY_BUFFER, buf);
      gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1,-1, 1,-1, -1,1, 1,1]), gl.STATIC_DRAW);
      const loc = gl.getAttribLocation(prog, 'p');
      gl.enableVertexAttribArray(loc);
      gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
      const U = n => gl.getUniformLocation(prog, n);
      gl.uniform2f(U('u_res'), 0, 0);
      gl.uniform3fv(U('u_base'), COLORS.base);
      gl.uniform3fv(U('u_c1'), COLORS.accents[0]);
      gl.uniform3fv(U('u_c2'), COLORS.accents[1]);
      gl.uniform3fv(U('u_c3'), COLORS.accents[2]);

      function resize() {
        const dpr = Math.min(window.devicePixelRatio || 1, 1.5);
        const r = canvas.getBoundingClientRect();
        canvas.width = r.width * dpr; canvas.height = r.height * dpr;
        gl.viewport(0, 0, canvas.width, canvas.height);
        gl.uniform2f(U('u_res'), canvas.width, canvas.height);
      }
      resize();
      window.addEventListener('resize', resize);

      const start = performance.now();
      let raf;
      function frame(now) {
        gl.uniform1f(U('u_time'), (now - start) / 1000);
        gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
        raf = requestAnimationFrame(frame);
      }
      // static first frame, then animate only while the tab is visible
      gl.uniform1f(U('u_time'), 12.0);
      gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
      raf = requestAnimationFrame(frame);
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) { cancelAnimationFrame(raf); }
        else { raf = requestAnimationFrame(frame); }
      });
    }
  }
  // No WebGL or reduced motion: the CSS fallback below is the whole visual.
</script>

<style>
  .hero-gradient {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    /* Static CSS fallback: soft lime/charcoal mists via radial gradients.
       Visible only if WebGL is unavailable or reduced motion is set. */
    background:
      radial-gradient(60% 55% at 8% 92%, rgba(163, 230, 53, 0.20), transparent 70%),
      radial-gradient(50% 45% at 95% 85%, rgba(10, 10, 10, 0.10), transparent 70%),
      radial-gradient(45% 40% at 85% 10%, rgba(77, 124, 15, 0.12), transparent 70%),
      transparent;
  }
  @media (prefers-color-scheme: dark) {
    .hero-gradient {
      background:
        radial-gradient(60% 55% at 8% 92%, rgba(77, 124, 15, 0.35), transparent 70%),
        radial-gradient(50% 45% at 95% 85%, rgba(163, 230, 53, 0.10), transparent 70%),
        radial-gradient(45% 40% at 85% 10%, rgba(46, 46, 46, 0.5), transparent 70%),
        transparent;
    }
  }
</style>
