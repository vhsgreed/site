---
// PostList.astro: the list of posts used on Writing, topic and Products pages.
import { topics } from '../site';
import { formatDate } from '../posts';
const { posts, showTopic = true } = Astro.props;
---
<ol class="post-list">
  {posts.map((p) => (
    <li>
      <a class="post-link" href={`/blog/${p.id}/`} lang={p.data.lang}>
        <span class="post-title">{p.data.title}</span>
        <span class="post-desc">{p.data.description}</span>
      </a>
      <span class="post-meta">
        <time datetime={p.data.date.toISOString()}>{formatDate(p.data.date)}</time>
        {showTopic && <> · <a href={`/topics/${p.data.topic}/`}>{topics[p.data.topic]}</a></>}
        {p.data.lang === 'sv' && <> · på svenska</>}
        {p.data.product && <> · <span class="badge">{p.data.product.url ? p.data.product.price : 'Service'}</span></>}
      </span>
    </li>
  ))}
</ol>
