---
// GDPR/IMY cookie consent. GA4 loads only after explicit approval (Consent Mode v2).
// Choice stored in localStorage: "vhsgreed.consent" = "granted" | "denied".
// Reopen: any element with [data-cookie-settings].
---

<div id="cookie-banner" class="cookie-banner" role="dialog" aria-live="polite" aria-label="Cookieval" hidden>
  <p class="cookie-text">
    We use cookies to understand how this site is used.
    <button type="button" class="cookie-btn" data-cookie-accept>Accept</button>
    <button type="button" class="cookie-btn cookie-btn-ghost" data-cookie-deny>Decline</button>
  </p>
</div>

<script is:inline>
  (function () {
    var KEY = 'vhsgreed.consent';

    // GA4 Consent Mode v2 default: analytics denied before any interaction.
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }
    gtag('consent', 'default', { analytics_storage: 'denied' });

    function loadGa() {
      if (document.getElementById('ga4-script')) return;
      var s = document.createElement('script');
      s.id = 'ga4-script';
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=G-E2E4K53319';
      document.head.appendChild(s);
      gtag('js', new Date());
      gtag('config', 'G-E2E4K53319');
    }

    function apply(choice, save) {
      if (save) { try { localStorage.setItem(KEY, choice); } catch (e) {} }
      gtag('consent', 'update', { analytics_storage: choice });
      if (choice === 'granted') loadGa();
      var b = document.getElementById('cookie-banner');
      if (b) { b.hidden = true; document.body.classList.remove('has-cookie-banner'); }
    }

    var saved = null;
    try { saved = localStorage.getItem(KEY); } catch (e) {}
    if (saved === 'granted' || saved === 'denied') {
      apply(saved, false);
    } else {
      var b = document.getElementById('cookie-banner');
      if (b) b.hidden = false;
    }

    document.addEventListener('click', function (e) {
      if (e.target.closest('[data-cookie-accept]')) apply('granted', true);
      else if (e.target.closest('[data-cookie-deny]')) apply('denied', true);
      else if (e.target.closest('[data-cookie-settings]')) {
        e.preventDefault();
        var b = document.getElementById('cookie-banner');
        if (b) b.hidden = false;
      } else if (window.gtag) {
        // Consent-gated GA4 conversion events: [data-track] click.
        var el = e.target.closest('[data-track]');
        if (el) {
          var label = el.getAttribute('data-track');
          gtag('event', label, {
            event_category: 'outbound',
            event_label: label,
            link_url: el.getAttribute('href') || '',
            transport_type: 'beacon'
          });
        }
      }
    });
  })();
</script>

<style>
  .cookie-banner {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 100;
    background: var(--ink);
    color: var(--bg);
    border-top: 2px solid var(--accent-strong);
  }
  .cookie-banner .cookie-text {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 0.85rem 1.5rem;
    font-size: 0.9rem;
    line-height: 1.6;
  }
  .cookie-btn {
    font-family: inherit;
    font-size: 0.85rem;
    border: 1px solid var(--accent-strong);
    background: var(--accent-strong);
    color: var(--ink);
    padding: 0.25rem 0.9rem;
    margin-left: 0.35rem;
    border-radius: 0; /* square corners: authority style */
    cursor: pointer;
  }
  .cookie-btn-ghost {
    background: transparent;
    color: var(--bg);
  }
  .cookie-btn:hover { opacity: 0.85; }
  @media (prefers-color-scheme: dark) {
    .cookie-banner { background: #1a1a1a; }
  }
</style>