---
import Base from '../../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { getAuthorName } from '../../../lib/authors';

const posts = (await getCollection('articles')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const authorName = getAuthorName;
const kindLabel = (k: string) => (({ 'build-log': 'Build log', story: 'Story', guide: 'Guide', insight: 'Insight' } as Record<string,string>)[k] ?? 'Article');
---
<Base title="Artiklar" description="Öppna byggloggar och forskningsnoteringar från vhsgreed." locale="sv">
  <div class="container">
    <section class="hero">
      <h1>Artiklar</h1>
      <p class="lead">Byggloggar och forskningsnoteringar från arbetsdokumentationen.</p>
      <p class="muted">Inläggen är på engelska. <a href="/sv/blog/">← Tillbaka till bloggen</a></p>
    </section>

    <hr class="rule" />

    <section class="section-tight">
      <div class="card-list">
        {posts.map((p) => (
          <a class="card-row" href={`/blog/articles/${p.id}/`}>
            <div>
              <div class="t">
                {p.data.kind && <span class="badge badge-article">{kindLabel(p.data.kind)}</span>}
                {p.data.title}
              </div>
              <div class="d">{p.data.description}</div>
            </div>
            <span class="meta">
              {p.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
            </span>
          </a>
        ))}
      </div>
    </section>
  </div>
</Base>