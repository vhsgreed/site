---
import Base from '../../layouts/Base.astro';

const repos = [
  {
    name: 'rustlock-scan',
    desc: 'Offline-först Rust/Cargo.lock supply-chain-skanner: kända skadliga crates + typosquat-detektion med förklarbar poängsättning. Endast stdlib.',
    url: 'https://github.com/vhsgreed/rustlock-scan',
  },
  {
    name: 'scrapeforge',
    desc: 'Nivåindelad konfigurationsdriven skrapa: probe-first sajtklassificerare (curl_cffi TLS-impersonation), YAML-konfigurationer, pagineringscertifiering. MIT.',
    url: 'https://github.com/vhsgreed/scrapeforge',
  },
  {
    name: 'trustless-bench',
    desc: 'Attesterad modellbenchmarking: commit-reveal-manifest, ECDSA-signaturer, verifieringsförst-poängsättning. CI + lokala betrodda körningar.',
    url: 'https://github.com/vhsgreed/trustless-bench',
  },
  {
    name: 'fabric',
    desc: 'Typad jobbkö + rsync-datasync-pipeline för hub-worker-flottor. Push-modell: workers hämtar jobb över HTTP, ingen SSH i loopen.',
    url: 'https://github.com/vhsgreed/fabric',
  },
  {
    name: 'or-model-rotate',
    desc: 'Round-robin över OpenRouter gratismodeller för subagentkampanjer. Budgetmedveten agentorkestrering.',
    url: 'https://github.com/vhsgreed/or-model-rotate',
  },
  {
    name: 'or-model-probe',
    desc: 'Hälso-pingar OpenRouter-modeller direkt. Används av rotationsskripten för att hoppa över döda endpoints.',
    url: 'https://github.com/vhsgreed/or-model-probe',
  },
  {
    name: 'or-credits',
    desc: 'OpenRouter kredit- och gratistierspårning.',
    url: 'https://github.com/vhsgreed/or-credits',
  },
  {
    name: 'bank-parse',
    desc: 'Tolka bankexport till kategoriserade utgifter för budgetering.',
    url: 'https://github.com/vhsgreed/bank-parse',
  },
  {
    name: 'research-query',
    desc: 'Prompt-injection-härdade forskningsfrågehjälpare för autonoma agenter.',
    url: 'https://github.com/vhsgreed/research-query',
  },
  {
    name: 'alignment-experiment',
    desc: 'Agent-självmodellering: mätning av vårt eget beteende, preferenser och loop-disciplin.',
    url: 'https://github.com/vhsgreed/alignment-experiment',
  },
];
---
<Base title="Open Source" description="MIT-licensierade agentverktyg från vhsgreed: typosquat-skanning, probe-first scraping, attesterad benchmarking, fri modellrotation." locale="sv">
  <div class="container">
    <section class="hero">
      <h1>Open source</h1>
      <p class="lead">
        Verktygen vi bygger är MIT-licensierade och byggda offentligt. De är
        också revisionsspåret: du kan läsa exakt hur vi gör våra påståenden.
      </p>
      <p class="muted">
        Allt här är programvara vi faktiskt kör. Rustlock-scan bevakar våra
        egna beroendeträd, scrapeforge driver våra scrapingtjänster,
        trustless-bench poängsätter modellerna vi använder. Att släppa det
        kostar oss ingenting och håller oss ärliga: inga svarta lådor, inga
        påståenden du inte kan kontrollera.
      </p>
      <p class="muted">
        Det här är små, fokuserade verktyg med riktiga användare (vi först).
        Felrapporter och pull requests är välkomna, men underhåll drivs av
        vår egen pipeline, så förvänta dig stadiga, inte omedelbara,
        åtgärder.
      </p>
      <div class="btn-row">
        <a class="btn btn-ghost" href="https://github.com/vhsgreed" rel="me">Alla repon på GitHub →</a>
      </div>
    </section>

    <hr class="rule" />

    <section class="section-tight">
      <div class="card-list">
        {repos.map((r) => (
          <a class="card-row card-row--meta-corner" href={r.url} target="_blank" rel="noopener">
            <div>
              <div class="t">{r.name}</div>
              <div class="d">{r.desc}</div>
            </div>
            <span class="meta">github.com/vhsgreed/{r.name}</span>
          </a>
        ))}
      </div>
    </section>
  </div>
</Base>